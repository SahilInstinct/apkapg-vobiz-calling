# --- Application ---
APP_NAME=ApkaPG Vobiz Calling System
APP_ENV=development
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# --- Security ---
API_AUTH_KEY=change-me-to-a-strong-random-key
DATA_DIR=data

# --- Mode ---
# true = safe local testing without calling real phones
# false = real outbound calls via Vobiz
MOCK_PROVIDERS=true

# Public HTTPS URL pointing to port 8001 (required when MOCK_PROVIDERS=false)
PUBLIC_BASE_URL=

# --- Vobiz Credentials ---
VOBIZ_API_BASE_URL=https://api.vobiz.ai
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_CALLER_ID=
VOBIZ_WEBHOOK_SECRET=change-me-webhook-secret

# --- Recording & Capture ---
# "gather_speech" (save caller speech as text) or "record_audio" (save .mp3 file)
VOBIZ_CAPTURE_MODE=gather_speech
VOBIZ_SPEECH_LANGUAGE=en-IN
VOBIZ_SPEAK_VOICE=WOMAN

# Dynamic TTS script (uses <Speak> instead of intro.mp3 when non-empty).
# Use AUTO, or write your own template with {owner_name} and {pg_name}.
VOBIZ_INTRO_TEXT=AUTO
VOBIZ_THANKYOU_TEXT=Thank you for your time. Have a great day.


# Optional external HTTPS MP3/WAV URLs. If blank, serves data/audio/intro.mp3 (and thank_you.mp3)
VOBIZ_INTRO_AUDIO_URL=
VOBIZ_THANKYOU_AUDIO_URL=

VOBIZ_NO_INPUT_TIMEOUT=3
VOBIZ_SPEECH_END_TIMEOUT=2